# ============================================================
# Chaves de API — preencha ao menos uma para executar o benchmark
# ============================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ============================================================
# Modelos usados por provedor (opcional — valores padrão abaixo)
# ============================================================
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-4-7
# GEMINI_MODEL=gemini-3.1-pro-preview
# XAI_MODEL=grok-4.3
# DEEPSEEK_MODEL=deepseek-v4-pro

# ============================================================
# Parâmetros do benchmark (opcional)
# ============================================================
BENCHMARK_CONCURRENCY=2
BENCHMARK_TEMPERATURE=0.7
BENCHMARK_MAX_TOKENS=4096
BENCHMARK_TIMEOUT=120
BENCHMARK_OUTPUT_DIR=results

# Desativa a verificação de certificados TLS (somente ambientes de teste).
# Recomendado manter `false` em produção.
DISABLE_SSL_VERIFY=false
